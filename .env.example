POSTGRES_DB=agentdeck
POSTGRES_USER=agentdeck
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+psycopg://agentdeck:change-me-in-production@postgres:5432/agentdeck
REDIS_URL=redis://redis:6379/0
